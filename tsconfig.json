{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Compiled from the submodule, not installed, so the specifier maps to the
    // built output it resolves to at runtime.
    "paths": {
      "@intisy-ai/core": ["./core/dist/index.d.ts"],
      "@intisy-ai/api": ["./core/api/generated/api.keys.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
